{
  "name": "speedyvideo",
  "private": false,
  "version": "1.0.5",
  "description": "A Chrome extension to control video playback speed on any website",
  "author": "SpeedyVideo Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/REDLANTERNDEV/speedyvideo"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/chrome": "^0.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
